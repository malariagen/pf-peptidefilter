.wrap{max-width:960px;margin:0 auto;padding:56px 28px 96px;display:flex;flex-direction:column;gap:52px}
.prose{max-width:70ch}
h1,h2,h3{font-family:Newsreader,Georgia,"Times New Roman",serif;text-wrap:balance;margin:0;font-weight:600;letter-spacing:-.008em}
h1{font-size:2.55rem;line-height:1.14}
h2{font-size:1.62rem;line-height:1.25}
