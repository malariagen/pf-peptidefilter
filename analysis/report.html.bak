p{margin:0 0 1rem}
p:last-child{margin-bottom:0}
a{color:var(--accent)}
code,.mono{font-family:"IBM Plex Mono",ui-monospace,monospace;font-size:.88em}
.eyebrow{font-size:.72rem;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);font-weight:500}

header{border-bottom:1px solid var(--rule);padding-bottom:34px;display:flex;flex-direction:column;gap:14px}
.lede{font-size:1.13rem;color:var(--ink-2);max-width:66ch;margin:0}
.meta{display:flex;flex-wrap:wrap;gap:8px 26px;font-size:.82rem;color:var(--muted)}
.meta b{color:var(--ink-2);font-weight:500}

section{display:flex;flex-direction:column;gap:20px}
.shead{display:flex;gap:16px;align-items:baseline;border-bottom:1px solid var(--rule);padding-bottom:12px}
.snum{font-family:"IBM Plex Mono",monospace;font-size:.9rem;color:var(--accent);font-weight:500;flex:none}

.callout{border:1px solid var(--flag-line);background:var(--flag-soft);border-radius:3px;padding:20px 22px;display:flex;flex-direction:column;gap:12px}
.callout .eyebrow{color:var(--flag)}
.callout.note{border-color:var(--accent-line);background:var(--accent-soft)}
.callout.note .eyebrow{color:var(--accent)}

blockquote{margin:0;padding:14px 0 14px 20px;border-left:2px solid var(--rule);color:var(--ink-2);font-family:Newsreader,Georgia,serif;font-size:1.03rem}
blockquote.wrong{border-left-color:var(--reject)}
blockquote.wrong .hl{background:var(--reject-soft);color:var(--reject);padding:1px 3px;border-radius:2px;font-weight:500}
.draft{background:var(--panel);border:1px solid var(--rule);border-radius:3px;padding:24px 26px;font-family:Newsreader,Georgia,serif;font-size:1.02rem;line-height:1.72;color:var(--ink)}
.draft .fix{background:var(--ok-soft);color:var(--ok);padding:1px 4px;border-radius:2px;font-weight:500;font-family:inherit}
.draft .todo{color:var(--muted);font-style:italic}

.tablebox{overflow-x:auto;border:1px solid var(--rule);border-radius:3px;background:var(--panel)}
table{border-collapse:collapse;width:100%;font-size:.83rem;font-variant-numeric:tabular-nums}
th,td{text-align:left;padding:9px 13px;border-bottom:1px solid var(--rule-soft);white-space:nowrap}
thead th{font-size:.7rem;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);font-weight:500;
  border-bottom:1px solid var(--rule);position:sticky;top:0;background:var(--panel)}
td.num,th.num{text-align:right;font-family:"IBM Plex Mono",monospace}
td.name{font-weight:500}
td.mono,th.mono{font-family:"IBM Plex Mono",monospace;font-size:.79rem}
tbody tr:last-child td{border-bottom:none}
tr.ref td{background:var(--accent-soft)}
tr.dead td{color:var(--reject)}
.note-under{font-size:.79rem;color:var(--muted);max-width:80ch}

.chip{display:inline-block;font-size:.68rem;letter-spacing:.05em;text-transform:uppercase;font-weight:500;
  padding:2px 7px;border-radius:2px;border:1px solid}
.chip.pass{color:var(--ok);border-color:var(--ok);background:var(--ok-soft)}
.chip.fail{color:var(--reject);border-color:var(--reject-line);background:var(--reject-soft)}
.chip.ok{color:var(--ok);border-color:var(--ok);background:var(--ok-soft)}
.mk{font-weight:600;margin-left:5px}
.mk.p{color:var(--ok)}
.mk.f{color:var(--reject)}

figure{margin:0;display:flex;flex-direction:column;gap:12px}
figure img{width:100%;height:auto;display:block;border:1px solid var(--rule);border-radius:3px;background:#fcfcfb}
figcaption{font-size:.82rem;color:var(--muted);max-width:80ch}

ul,ol{margin:0;padding-left:1.25rem;display:flex;flex-direction:column;gap:8px}
li::marker{color:var(--muted)}

.kv{display:grid;grid-template-columns:auto 1fr;gap:8px 20px;font-size:.87rem;align-items:baseline}
.kv dt{color:var(--muted)}
.kv dd{margin:0;color:var(--ink)}

.decision{border:1px solid var(--accent-line);background:var(--panel);border-radius:3px;padding:22px 24px;display:flex;flex-direction:column;gap:14px}
footer{border-top:1px solid var(--rule);padding-top:22px;font-size:.82rem;color:var(--muted)}
