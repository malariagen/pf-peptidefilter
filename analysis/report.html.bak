        <th class="num">Max freq<br>need 0.99</th>
        <th class="num">Indel<br>need 100%</th>
        <th class="num">D4 reps<br>need 3</th>
        <th><i>P. vivax</i></th><th>Excluded by</th>
      </tr></thead>
      <tbody>
